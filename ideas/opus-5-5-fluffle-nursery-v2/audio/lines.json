{
  "lines": [
    {
      "id": "welcome",
      "speaker": "narrator",
      "text": "Hello, Nurse Emma! Welcome to the Fluffle Nursery."
    },
    {
      "id": "arrive",
      "speaker": "narrator",
      "text": "Look! A cloud brought a basket. Tap the basket."
    },
    {
      "id": "baby",
      "speaker": "narrator",
      "text": "A baby Fluffle!"
    },
    {
      "id": "no-talk",
      "speaker": "narrator",
      "text": "Fluffles can't talk. Read their bubbles."
    },
    {
      "id": "pom-watch",
      "speaker": "narrator",
      "text": "This is Pom. Watch!"
    },
    {
      "id": "naming-goal",
      "speaker": "narrator",
      "text": "Your baby needs a name. You choose!"
    },
    {
      "id": "naming-how",
      "speaker": "narrator",
      "text": "Tap a gem to hear it. Put one in the box."
    },
    {
      "id": "naming-slide",
      "speaker": "narrator",
      "text": "Slide the star, and listen."
    },
    {
      "id": "naming-heart",
      "speaker": "narrator",
      "text": "Do you like it? Tap the heart."
    },
    {
      "id": "wish-goal",
      "speaker": "narrator",
      "text": "Your Fluffle wants something."
    },
    {
      "id": "read-bubble",
      "speaker": "narrator",
      "text": "Read the bubble."
    },
    {
      "id": "wish-how",
      "speaker": "narrator",
      "text": "Tap the dots. Then slide the star.",
      "seed": 21
    },
    {
      "id": "dots-how",
      "speaker": "narrator",
      "text": "Tap every dot."
    },
    {
      "id": "find",
      "speaker": "narrator",
      "text": "Find the thing you read."
    },
    {
      "id": "give",
      "speaker": "narrator",
      "text": "Give it to your Fluffle."
    },
    {
      "id": "not-that",
      "speaker": "narrator",
      "text": "Not that one. Read the bubble again."
    },
    {
      "id": "it-says",
      "speaker": "narrator",
      "text": "It says..."
    },
    {
      "id": "golden",
      "speaker": "narrator",
      "text": "Ooh, a golden wish!"
    },
    {
      "id": "golden-sticker",
      "speaker": "narrator",
      "text": "A golden sticker!"
    },
    {
      "id": "hungry",
      "speaker": "narrator",
      "text": "Your Fluffle is hungry!"
    },
    {
      "id": "fill-tummy",
      "speaker": "narrator",
      "text": "Fill up the tummy."
    },
    {
      "id": "look-number",
      "speaker": "narrator",
      "text": "Look at the number."
    },
    {
      "id": "berries-how",
      "speaker": "narrator",
      "text": "Put berries on the plate. Give it to your Fluffle."
    },
    {
      "id": "just-right",
