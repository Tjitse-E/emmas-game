{
  "lines": [
    {
      "id": "goal-play",
      "speaker": "narrator",
      "text": "Tap Play to make magic!"
    },
    {
      "id": "goal-colour",
      "speaker": "narrator",
      "text": "What colour is it? Tap one."
    },
    {
      "id": "goal-wheel",
      "speaker": "narrator",
      "text": "Tap a gem to change it. Then slide your finger along the wand."
    },
    {
      "id": "goal-heart",
      "speaker": "narrator",
      "text": "Tap the heart, or the round arrow."
    },
    {
      "id": "goal-gems",
      "speaker": "narrator",
      "text": "Put the gems on the wand."
    },
    {
      "id": "goal-slide",
      "speaker": "narrator",
      "text": "Now slide your finger along the wand."
    },
    {
      "id": "goal-star",
      "speaker": "narrator",
      "text": "Slide all the way to the star."
    },
    {
      "id": "goal-number",
      "speaker": "narrator",
      "text": "Put a number on your wand."
    },
    {
      "id": "goal-count",
      "speaker": "narrator",
      "text": "Tap them to count."
    },
    {
      "id": "goal-two",
      "speaker": "narrator",
      "text": "Is it this one, or this one?"
    },
    {
      "id": "goal-shelf",
      "speaker": "narrator",
      "text": "On the shelf."
    },
    {
      "id": "goal-note",
      "speaker": "narrator",
      "text": "Slide under the note. Then give Sizzle the right thing."
    },
    {
      "id": "goal-queen-note",
      "speaker": "narrator",
      "text": "The Queen sent you a note. Do what it says!"
    },
    {
      "id": "goal-read",
      "speaker": "narrator",
      "text": "Read the note. Slide under a word to hear its sounds."
    },
    {
      "id": "goal-scroll",
      "speaker": "narrator",
      "text": "Do you want to try? Tap the scroll, or wave bye bye."
    },
    {
      "id": "goal-choice",
      "speaker": "narrator",
      "text": "Do you want to make more magic? Tap the wand. Or tap the moon for bedtime."
    },
    {
      "id": "goal-newday",
      "speaker": "narrator",
      "text": "Tap the sun for a new day!"
    },
    {
      "id": "goal-close",
      "speaker": "narrator",
      "text": "Tap the cross to close your book."
    },
    {
