    {
      "id": "pippa-hello",
      "speaker": "pippa",
      "text": "Hello, Princess Emma! I am Princess Pippa. This magic wand is for you!"
    },
    {
      "id": "pippa-basket",
      "speaker": "pippa",
      "text": "Oh! Something is in my sock basket!"
    },
    {
      "id": "pippa-bobbin",
      "speaker": "pippa",
      "text": "A baby Bobbin! It is so fluffy!"
    },
    {
      "id": "pippa-name",
      "speaker": "pippa",
      "text": "It needs a name. Let's make one with your wand!"
    },
    {
      "id": "pippa-watch",
      "speaker": "pippa",
      "text": "Watch me first!"
    },
    {
      "id": "pippa-first",
      "speaker": "pippa",
      "text": "What is the first sound?"
    },
    {
      "id": "pippa-here",
      "speaker": "pippa",
      "text": "Here it is!"
    },
    {
      "id": "pippa-next",
      "speaker": "pippa",
      "text": "Next sound?"
    },
    {
      "id": "pippa-last",
      "speaker": "pippa",
      "text": "Last sound?"
    },
    {
      "id": "pippa-slide",
      "speaker": "pippa",
      "text": "Now I slide."
    },
    {
      "id": "pippa-turn",
      "speaker": "pippa",
      "text": "Now it is your turn, Princess Emma!"
    },
    {
      "id": "pippa-knock",
      "speaker": "pippa",
      "text": "Knock knock! Who is it?"
    },
    {
      "id": "pippa-duck",
      "speaker": "pippa",
      "text": "It is Mrs Duck and her ducklings!"
    },
    {
      "id": "pippa-goat",
      "speaker": "pippa",
      "text": "It is Grandpa Goat!"
    },
    {
      "id": "pippa-sizzle",
      "speaker": "pippa",
      "text": "Look! It is Sizzle the baby dragon!"
    },
    {
      "id": "pippa-dot",
      "speaker": "pippa",
      "text": "Oh! It is Dot the unicorn foal!"
    },
    {
      "id": "pippa-onetoo",
      "speaker": "pippa",
      "text": "Your Bobbin wants one too. Watch me!"
    },
    {
      "id": "pippa-nowyou",
      "speaker": "pippa",
      "text": "Now you!"
    },
    {
      "id": "pippa-thanks",
      "speaker": "pippa",
      "text": "They say thank you, Princess Emma!"
    },
    {
      "id": "pippa-party",
      "speaker": "pippa",
      "text": "The Queen is having a tea party! Let's go!"
    },
    {
      "id": "pippa-morning",
      "speaker": "pippa",
      "text": "Good morning, Princess Emma!"
    },
    {
      "id": "queen-welcome",
      "speaker": "queen",
      "text": "Welcome to my tea party!"
    },
    {
      "id": "queen-giggle",
      "speaker": "queen",
      "text": "Oh, how funny!"
    },
    {
      "id": "queen-thanks",
      "speaker": "queen",
      "text": "Thank you, Princess Emma! Here is a crown for you."
    },
