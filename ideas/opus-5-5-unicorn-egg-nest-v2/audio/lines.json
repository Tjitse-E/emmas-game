{
  "lines": [
    {"id": "lumi-hello", "speaker": "queen", "text": "Hello, Emma! I'm Queen Lumi."},
    {"id": "lumi-help", "speaker": "queen", "text": "My unicorn eggs need a Nest Keeper. Will you help me?"},
    {"id": "lumi-crown", "speaker": "queen", "text": "Here is your crown. You are my Nest Keeper now!"},
    {"id": "lumi-welcome", "speaker": "queen", "text": "Welcome back, Nest Keeper! Your unicorns missed you."},
    {"id": "lumi-egg-comes", "speaker": "queen", "text": "Here comes an egg. Ooh, it's cold!"},
    {"id": "lumi-two-eggs", "speaker": "queen", "text": "Two eggs tonight! A speckled egg, or a golden egg?"},
    {"id": "lumi-hatching", "speaker": "queen", "text": "It's hatching!"},
    {"id": "lumi-baby", "speaker": "queen", "text": "A baby unicorn! Hello, little one."},
    {"id": "lumi-sparkly", "speaker": "queen", "text": "Ooh, a sparkly one!"},
    {"id": "lumi-more-names", "speaker": "queen", "text": "More names!"},
    {"id": "lumi-off", "speaker": "queen", "text": "Off you go to the meadow!"},
    {"id": "lumi-new-baby", "speaker": "queen", "text": "A new baby! Your family is growing."},
    {"id": "lumi-sticker", "speaker": "queen", "text": "A new sticker for your Nest Book!"},
    {"id": "lumi-jar", "speaker": "queen", "text": "The jar is full! A present from me."},
    {"id": "lumi-bedtime", "speaker": "queen", "text": "The moon is high. Bedtime, babies!"},
    {"id": "lumi-night", "speaker": "queen", "text": "Night night, little one."},
    {"id": "lumi-goodnight", "speaker": "queen", "text": "Well done, Nest Keeper. Night night. See you tomorrow!"},
    {"id": "lumi-full", "speaker": "queen", "text": "The meadow is full, so no more eggs tonight. A new egg comes tomorrow night!"},
    {"id": "foal-hello", "speaker": "foal", "text": "[giggles] Hello!"},
    {"id": "foal-please", "speaker": "foal", "text": "Please? Pleeease?"},
    {"id": "foal-yay", "speaker": "foal", "text": "[excited] Yay! Thank you!"},
    {"id": "foal-silly", "speaker": "foal", "text": "[giggles] Silly!"},
    {"id": "foal-no", "speaker": "foal", "text": "No, thank you."},
    {"id": "foal-notme", "speaker": "foal", "text": "[giggles] Not me!"},
    {"id": "foal-wee", "speaker": "foal", "text": "Wheee!"},
    {"id": "foal-yum", "speaker": "foal", "text": "Mmm! Yummy!"},
    {"id": "foal-cuddle", "speaker": "foal", "text": "[happy sigh] Aww."},
    {"id": "foal-yawn", "speaker": "foal", "text": "[yawns] Sleepy."},
    {"id": "g-crown", "speaker": "narrator", "text": "Tap your crown."},
    {"id": "g-pick-egg", "speaker": "narrator", "text": "Tap an egg. The golden egg is tricky!"},
    {"id": "g-egg", "speaker": "narrator", "text": "Make every cup warm, and the egg will hatch."},
    {"id": "g-stone", "speaker": "narrator", "text": "Drag one stone to the nest."},
    {"id": "g-two-stones", "speaker": "narrator", "text": "This egg needs two stones. Together they make every cup warm."},
    {"id": "g-one-more", "speaker": "narrator", "text": "Now one more stone."},
    {"id": "g-blanket", "speaker": "narrator", "text": "The blanket hides the cups."},
    {"id": "g-which", "speaker": "narrator", "text": "Which stone makes ten?"},
    {"id": "fb-warm", "speaker": "narrator", "text": "Every cup is warm!"},
    {"id": "fb-hot", "speaker": "narrator", "text": "Too hot!"},
    {"id": "fb-brr", "speaker": "narrator", "text": "Brr!"},
    {"id": "fb-smaller", "speaker": "narrator", "text": "Try a smaller stone."},
    {"id": "fb-bigger", "speaker": "narrator", "text": "Try a bigger stone."},
    {"id": "h-count", "speaker": "narrator", "text": "Let's count the cold cups."},
    {"id": "h-peek", "speaker": "narrator", "text": "Let's peek under the blanket."},
    {"id": "g-bells", "speaker": "narrator", "text": "Your baby needs a name! Tap a bell to hear a name."},
    {"id": "g-bell-drag", "speaker": "narrator", "text": "Drag the name you like to your baby."},
    {"id": "fb-lovely", "speaker": "narrator", "text": "Lovely!"},
    {"id": "g-spell", "speaker": "narrator", "text": "Let's write the name on the tag. Listen."},
    {"id": "g-gems", "speaker": "narrator", "text": "Put the gems in the slots."},
    {"id": "fb-pink", "speaker": "narrator", "text": "Pink gems go in the pink slot."},
    {"id": "fb-blue", "speaker": "narrator", "text": "Blue gems go in the blue slot."},
    {"id": "fb-twin", "speaker": "narrator", "text": "Two-letter gems go in the double slot."},
    {"id": "g-slide", "speaker": "narrator", "text": "Now slide the star, and listen."},
    {"id": "fb-spelled", "speaker": "narrator", "text": "You wrote your baby's name!"},
    {"id": "fb-listen", "speaker": "narrator", "text": "Hmm. Listen again."},
    {"id": "h-sounds", "speaker": "narrator", "text": "Listen to the sounds."},
    {"id": "g-gold", "speaker": "narrator", "text": "Make any name you like!"},
    {"id": "fb-gold-yes", "speaker": "narrator", "text": "What a lovely name!"},
    {"id": "fb-tricky", "speaker": "narrator", "text": "What a great name! It's a tricky one for me to say."},
    {"id": "fb-gold-other", "speaker": "narrator", "text": "Let's pick a different name. Try other gems!"},
    {"id": "fb-same-2", "speaker": "narrator", "text": "Another one! Now you have two."},
    {"id": "fb-same-3", "speaker": "narrator", "text": "Another one! Now you have three."},
    {"id": "fb-same-4", "speaker": "narrator", "text": "Another one! Now you have four."},
    {"id": "fb-same-5", "speaker": "narrator", "text": "Another one! Now you have five."},
    {"id": "fb-same-lots", "speaker": "narrator", "text": "Another one! Now you have lots!"},
    {"id": "g-wish", "speaker": "narrator", "text": "Look at the letters. What does the baby want?"},
    {"id": "g-give", "speaker": "narrator", "text": "Drag it to the baby."},
    {"id": "fb-letters", "speaker": "narrator", "text": "Look at the letters again."},
    {"id": "g-gift", "speaker": "narrator", "text": "Look at the letters. Pick a present!"},
    {"id": "g-play", "speaker": "narrator", "text": "Play time! Drag the brush, the treats or the heart to a baby."},
    {"id": "g-play-egg", "speaker": "narrator", "text": "Or tap the little egg for one more baby."},
    {"id": "g-moon", "speaker": "narrator", "text": "Tap the moon when it's bedtime."},
    {"id": "g-sleepy", "speaker": "narrator", "text": "The moon is getting sleepy. Tap the moon for bedtime."},
    {"id": "g-hiding", "speaker": "narrator", "text": "Oh! They are hiding. Look at the letters on the signs."},
    {"id": "g-where", "speaker": "narrator", "text": "Where are you?"},
    {"id": "fb-moved", "speaker": "narrator", "text": "They moved!"},
    {"id": "g-bed", "speaker": "narrator", "text": "Drag your baby to the bed."},
    {"id": "g-next", "speaker": "narrator", "text": "Tap the moon to start the next night."},
